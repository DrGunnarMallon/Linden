{
  "name": "linden",
  "private": true,
  "version": "0.0.0",
  "description": "Free, browser-based stratigraphic diagrams for palaeoecological data",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @linden/app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
