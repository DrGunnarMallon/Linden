{
  "presetVersion": 2,
  "name": "diatom-percent",
  "description": "Diatoms: % of total valves, 2% inclusion threshold, weighted-average-depth ordering.",
  "transforms": [{ "type": "percent" }],
  "selectionDefaults": { "minMax": 2, "order": "weightedAverageDepth" },
  "panelDefaults": {
    "taxonCurves": {
      "commonScale": true, "minWidth": 3,
      "curve": {
        "type": "polygon", "fill": { "colour": "#3a6f8f" }, "plus": { "show": true, "threshold": 0.5 }
      }
    }
  }
}
